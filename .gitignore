
# Python environment and cache
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Raw and generated datasets
data/raw/
data/india/
data/processed/
results/*

# Trained models and scalers
*.keras
*.h5
*.pkl
*.joblib

# Secrets
.env
.env.*
!.env.example
.cdsapirc

# Local editor and OS files
.vscode/
.DS_Store
Thumbs.db

# Generated training arrays
*.npy

# Generated experiment outputs
*.csv
*.nc
*.zip

# Local backups of edited files
backups/

# Generated model artefacts and arrays
models/paper/
*.npz

# Curated result snapshot for readers (written by evaluation/export_docs_assets.py)
!docs/assets/*.csv

# Notebook and test caches, local logs
.ipynb_checkpoints/
*.log

# Small result files cited by README.md and docs/ (main causal run, its
# baselines, the 13 figures, the replication-gap analysis). Everything else in
# results/ stays local; predictions (*.npz) and scalers (*.pkl) stay ignored
# by the rules above.
!results/figures/
!results/causal_hourly_fig1heads_seed42/
!results/causal_baseline_audit/
!results/why_results_differ/
!results/replication_audit/
!results/causal_hourly_fig1heads_seed42/training_log.csv
!results/why_results_differ/*.csv
!results/replication_audit/*.csv
